<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Character</title>
</head>
<body>
    <h1>Stats for <%=c_name%></h1>
    <p>Wit: <%= c_wit %></p>
    <p>Strength: <%= c_strength %></p>
    <p>Attack: <%= c_attack %></p>
    <p>Defense: <%= c_defense %></p>
    <p>Magic: <%= c_magic %></p>
    <br>
    <h1>Update stats</h1>
    <form action="/update" method='POST'>
        <input type="hidden" name="c_name" value=<%=c_name%>
        
        <p>Wit</p>
        <input type="text" name="c_wit">
       
        <p>Strength</p>
        <input type="text" name="c_strength">
       
        <p>Attack</p>
        <input type="text" name="c_attack">
       
        <p>Defense</p>
        <input type="text" name="c_defense">
        
        <p>Magic</p>
        <input type="text" name="c_magic">
        <br><br>
        <button type="submit">Submit</button>
    </form>
</body>
</html>