<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assign Quest</title>
</head>

<body>
    <form action="/assign" method='POST'>
        <input type="hidden" name="table" value="assigned_q">
        <h3>Choose character</h3>
        <select name="character">
            <% for (let i=0; i<c.length; i++) { %>
                <option value="<%=c[i]['c_id']%>">
                    <%=c[i]["c_name"]%>
                </option>
                <% } %>
        </select>
        <br>
        <h3>Choose quest</h3>
        <% for (let i=0; i<q.length; i++) { %>
            <input type="checkbox" name="<%=q[i]['q_id']%>" value="<%=q[i]['q_id']%>">
            <%=q[i]['q_desc']%> <br>
        <% } %>
        <br>
        <button type="submit">Submit</button>
    </form>
</body>

</html>