<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule</title>
</head>
<body>
    <% let blocks = results[0]["day_type"]["blocks"] %>
    <% for (let i=0; i<blocks.length; i++) { %>
        <p><%= blocks[i]["name"] %> <%= blocks[i]["start"] %> <%= blocks[i]["end"] %> </p>
    <% } %>
</body>
</html>