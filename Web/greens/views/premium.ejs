<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Premium Page</title>
</head>
<body>
    <% if (logged_in) { %>
        <p>You are logged in.</p>
    <% } else { %>
        <p>You are not logged in</p>
    <% } %>
    
    <% if (visits<5 && logged_in) { %>
        <p>This is secret content that you can only view 5 times (you've seen it <%=visits%> times).</p>
    <% } else { %>
        <p>You've seen this too many times (<%= visits%>)!</p>
    <% } %>

</body>
</html>